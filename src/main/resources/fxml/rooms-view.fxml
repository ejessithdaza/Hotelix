<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.RoomsController"
            styleClass="app-shell">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="240" minWidth="240" maxWidth="240" styleClass="sidebar">
            <HBox styleClass="sidebar-brand">
                <Label text="Hotelix" styleClass="display-lg-sm"/>
            </HBox>

            <VBox styleClass="sidebar-nav">
                <Button fx:id="navHomeButton" text="INICIO" maxWidth="Infinity" onAction="#handleNavHome" styleClass="sidebar-item"/>
                <Button fx:id="navIndicatorsButton" text="INDICADORES" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navRoomsButton" text="HABITACIONES" maxWidth="Infinity" styleClass="sidebar-item, sidebar-item-active"/>
                <Button fx:id="navReservationsButton" text="RESERVAS" maxWidth="Infinity" onAction="#handleNavReservations" styleClass="sidebar-item"/>
                <Button fx:id="navCalendarButton" text="CALENDARIO" maxWidth="Infinity" onAction="#handleNavCalendar" styleClass="sidebar-item"/>
                <Button fx:id="navGuestsButton" text="HUÉSPEDES" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navMaintenanceButton" text="MANTENIMIENTO" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navLostFoundButton" text="OBJETOS PERDIDOS" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navServicesButton" text="SERVICIOS" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navSettingsButton" text="AJUSTES" maxWidth="Infinity" styleClass="sidebar-item"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="register-scroll">
            <VBox styleClass="main-content">

                <!-- Header -->
                <HBox styleClass="page-header">
                    <Label text="Habitaciones" styleClass="display-lg"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newRoomButton"
                            text="NUEVA HABITACIÓN"
                            onAction="#handleNewRoom"
                            styleClass="btn-primary, btn-primary-inline"/>
                </HBox>

                <!-- Filters -->
                <GridPane hgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="200" prefWidth="200" maxWidth="200"/>
                        <ColumnConstraints minWidth="240" prefWidth="240" maxWidth="240"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" styleClass="form-group-compact">
                        <Label text="Buscar por número" styleClass="label-md"/>
                        <TextField fx:id="searchField"
                                   promptText="Ej. 104"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" styleClass="form-group-compact">
                        <Label text="Tipo" styleClass="label-md"/>
                        <ComboBox fx:id="typeFilterCombo"
                                  maxWidth="Infinity"
                                  styleClass="hotelix-select"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" styleClass="form-group-compact">
                        <Label text="Estado" styleClass="label-md"/>
                        <ComboBox fx:id="statusFilterCombo"
                                  maxWidth="Infinity"
                                  styleClass="hotelix-select"/>
                    </VBox>
                </GridPane>

                <!-- Summary -->
                <Label fx:id="summaryLabel"
                       text="8 habitaciones · 4 disponibles · 2 ocupadas · 1 en mantenimiento · 1 fuera de servicio"
                       styleClass="body-sm"/>

                <!-- Rooms Table -->
                <VBox styleClass="section-block">
                    <VBox styleClass="table-card">
                        <TableView fx:id="roomsTable"
                                   prefHeight="496"
                                   minHeight="496"
                                   styleClass="hotelix-table">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="numberColumn" text="Número" styleClass="col-right"/>
                                <TableColumn fx:id="typeColumn" text="Tipo"/>
                                <TableColumn fx:id="floorColumn" text="Piso" styleClass="col-right"/>
                                <TableColumn fx:id="capacityColumn" text="Capacidad" styleClass="col-right"/>
                                <TableColumn fx:id="rateColumn" text="Tarifa por noche" styleClass="col-right"/>
                                <TableColumn fx:id="statusColumn" text="Estado"/>
                                <TableColumn fx:id="actionsColumn" text="" styleClass="col-right"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <Label fx:id="showingLabel"
                           text="Mostrando 8 de 8 habitaciones"
                           styleClass="body-sm"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
