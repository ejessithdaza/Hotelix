<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ReservationsController"
            styleClass="app-shell">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="240" minWidth="240" maxWidth="240" styleClass="sidebar">
            <HBox styleClass="sidebar-brand">
                <Label text="Hotelix" styleClass="display-lg-sm"/>
            </HBox>

            <VBox styleClass="sidebar-nav">
                <Button fx:id="navHomeButton" text="INICIO" maxWidth="Infinity" onAction="#handleNavHome" styleClass="sidebar-item"/>
                <Button fx:id="navIndicatorsButton" text="INDICADORES" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navRoomsButton" text="HABITACIONES" maxWidth="Infinity" onAction="#handleNavRooms" styleClass="sidebar-item"/>
                <Button fx:id="navReservationsButton" text="RESERVAS" maxWidth="Infinity" styleClass="sidebar-item, sidebar-item-active"/>
                <Button fx:id="navCalendarButton" text="CALENDARIO" maxWidth="Infinity" onAction="#handleNavCalendar" styleClass="sidebar-item"/>
                <Button fx:id="navGuestsButton" text="HUÉSPEDES" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navMaintenanceButton" text="MANTENIMIENTO" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navLostFoundButton" text="OBJETOS PERDIDOS" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navServicesButton" text="SERVICIOS" maxWidth="Infinity" styleClass="sidebar-item"/>
                <Button fx:id="navSettingsButton" text="AJUSTES" maxWidth="Infinity" styleClass="sidebar-item"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="register-scroll">
            <VBox styleClass="main-content">

                <!-- Header -->
                <HBox styleClass="page-header">
                    <Label text="Reservas" styleClass="display-lg"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newReservationButton"
                            text="NUEVA RESERVA"
                            onAction="#handleNewReservation"
                            styleClass="btn-primary, btn-primary-inline"/>
                </HBox>

                <!-- Filters -->
                <GridPane hgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="180" prefWidth="180" maxWidth="180"/>
                        <ColumnConstraints minWidth="165" prefWidth="165" maxWidth="165"/>
                        <ColumnConstraints minWidth="165" prefWidth="165" maxWidth="165"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" styleClass="form-group-compact">
                        <Label text="Buscar por huésped o habitación" styleClass="label-md"/>
                        <TextField fx:id="searchField"
                                   promptText="Ej. Laura o 101"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" styleClass="form-group-compact">
                        <Label text="Estado" styleClass="label-md"/>
                        <ComboBox fx:id="statusFilterCombo"
                                  maxWidth="Infinity"
                                  styleClass="hotelix-select"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" styleClass="form-group-compact">
                        <Label text="Desde" styleClass="label-md"/>
                        <TextField fx:id="fromDateField"
                                   text="23/11/2026"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox GridPane.columnIndex="3" styleClass="form-group-compact">
                        <Label text="Hasta" styleClass="label-md"/>
                        <TextField fx:id="toDateField"
                                   text="31/12/2026"
                                   styleClass="input-field"/>
                    </VBox>
                </GridPane>

                <!-- Summary -->
                <Label fx:id="summaryLabel"
                       text="7 reservas · 3 confirmadas · 2 activas · 1 finalizada · 1 cancelada"
                       styleClass="body-sm"/>

                <!-- Reservations Table -->
                <VBox styleClass="section-block">
                    <VBox styleClass="table-card">
                        <TableView fx:id="reservationsTable"
                                   prefHeight="496"
                                   minHeight="496"
                                   styleClass="hotelix-table">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="guestColumn" text="Huésped" minWidth="130" prefWidth="150"/>
                                <TableColumn fx:id="roomColumn" text="Habitación" minWidth="95" prefWidth="100" styleClass="col-right"/>
                                <TableColumn fx:id="checkInColumn" text="Llegada" minWidth="80" prefWidth="85" styleClass="col-right"/>
                                <TableColumn fx:id="checkOutColumn" text="Salida" minWidth="80" prefWidth="85" styleClass="col-right"/>
                                <TableColumn fx:id="nightsColumn" text="Noches" minWidth="70" prefWidth="75" styleClass="col-right"/>
                                <TableColumn fx:id="statusColumn" text="Estado" minWidth="115" prefWidth="120"/>
                                <TableColumn fx:id="amountColumn" text="Alojamiento" minWidth="105" prefWidth="110" styleClass="col-right"/>
                                <TableColumn fx:id="actionsColumn" text="" minWidth="200" prefWidth="215" styleClass="col-right"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <Label fx:id="showingLabel"
                           text="Mostrando 7 de 7 reservas"
                           styleClass="body-sm"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
